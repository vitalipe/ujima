;; UjimaOS desktop app catalog — baked into the image at /opt/ujima/desktop/apps.edn.
;; One declarative entry per app; the agent's per-:kind launch strategy applies the mechanics
;; (--class stamping, per-app ephemeral profile, workspace assignment). Adding an app = one entry.
;;
;;   :kind  :shell   the launcher (an eww window, not a spawned process)
;;          :web     chromium --app=<:url>, stamped --class=ujima-<:id>, per-app ephemeral profile
;;          :desktop native app, :exec verbatim, tracked by its natural :wm-class
;;   :icon  name under /opt/ujima/desktop/icons/<icon>.svg (defaults to :id); dock renders it from
;;          the snapshot, the launcher hardcodes it. SVGs live in assets/desktop/icons/.
{:apps
 [{:id :launcher
   :label "Ujima"
   :kind :shell
   :icon "launcher"
   :wm-class "Eww"
   :instance-policy :single
   :show-topbar? false
   :closable? false}

  {:id :wikipedia
   :label "Wikipedia"
   :kind :web
   :icon "wikipedia"
   :url "https://wikipedia.com"
   :instance-policy :single
   :show-topbar? true
   :closable? true
   :after-close :launcher}

  {:id :books
   :label "Books"
   :kind :web
   :icon "books"
   :url "http://ujima-content.local/books"
   :instance-policy :single
   :show-topbar? true
   :closable? true
   :after-close :launcher}

  {:id :write
   :label "Write"
   :kind :desktop
   :icon "write"
   :exec ["libreoffice" "--writer"]
   :wm-class "libreoffice-writer"
   :instance-policy :single
   :show-topbar? true
   :closable? true
   :after-close :launcher}

  {:id :draw
   :label "Draw"
   :kind :desktop
   :icon "draw"
   :exec ["tuxpaint"]
   :wm-class "TuxPaint.TuxPaint"
   :instance-policy :single
   :show-topbar? true
   :closable? true
   :after-close :launcher}

  {:id :files
   :label "Files"
   :kind :desktop
   :icon "files"
   :exec ["pcmanfm" "/home/ujima/Files"]
   :wm-class "pcmanfm"
   :instance-policy :single
   :show-topbar? true
   :closable? true
   :after-close :launcher}]}
