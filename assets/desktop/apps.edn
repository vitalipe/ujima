;; UjimaOS app catalog — pure-data launch specs (tmp/app-model/index.md), baked to
;; /opt/ujima/desktop/apps.edn. The agent loads it once at init (ujima.desktop.app) as by-id
;; sugar for the HTTP/eww edge; the executor never consults it. Adding an app = one entry.
;;
;;   :exec        command + params — content (URLs, documents) lives here, never in the model
;;   :class       natural WM_CLASS (native apps) — the window-adoption key
;;   :class-flag  stamped-class apps (chromium) get <flag>=ujima-<id> at spawn instead;
;;                their adoption key is ujima-<id>
;;   :icon        name under /opt/ujima/desktop/icons/<icon>.svg (defaults to :id)
;;   :on-exit     :close (default) | :relaunch — uncommanded-death policy (startup slice)
{:apps
 [{:id    :wikipedia
   :label "Wikipedia"
   :icon  "wikipedia"
   :exec  ["chromium" "--app=https://wikipedia.com"]
   :class-flag "--class"}

  {:id    :books
   :label "Books"
   :icon  "books"
   :exec  ["chromium" "--app=http://ujima-content.local/books"]
   :class-flag "--class"}

  {:id    :write
   :label "Write"
   :icon  "write"
   :exec  ["libreoffice" "--writer"]
   :class "libreoffice-writer"}

  {:id    :draw
   :label "Draw"
   :icon  "draw"
   :exec  ["tuxpaint"]
   :class "TuxPaint.TuxPaint"}

  {:id    :files
   :label "Files"
   :icon  "files"
   :exec  ["pcmanfm" "/home/ujima/Files"]
   :class "pcmanfm"}]}
