;; UjimaOS desktop shell — minimal eww surfaces: top (title + close), mid (launcher), bottom (dock).
;; Driven by the agent: one NDJSON snapshot per change in via deflisten; commands POST back.
;; `eww` and `curl` assumed on PATH. Exact syntax may need a nudge for the installed eww version.

(defvar api "http://127.0.0.1:1337/api/desktop")

(deflisten desktop
  :initial `{"windows":[],"current":"launcher","currentWindow":null,"status":"ok"}`
  `curl -sN --retry 999 --retry-connrefused http://127.0.0.1:1337/api/desktop/stream`)

(defpoll clock :interval "10s" "date +%H:%M")

;; mock sound state — the real pactl audio is flaky, so the overlay is UI-only for now
(defvar ewwcmd "eww --config /opt/ujima/desktop/eww")
(defvar vol 65)
(defvar muted false)


;; --- top: current window title + close -----------------------------------
(defwidget topbar []
  (centerbox :class "topbar"
    (label :class "title" :halign "start"
           :text {desktop.currentWindow.showTopbar ? desktop.currentWindow.title : ""})
    (box)
    (button :class "close" :halign "end"
            :visible {desktop.currentWindow.closable}
            :onclick "curl -sX POST ${api}/windows/current/close"
            "✕")))

;; --- mid: launcher tiles -------------------------------------------------
(defwidget launcher []
  (box :class "launcher" :orientation "v" :halign "center" :valign "center" :space-evenly false
    (label :class "brand" :text "Ujima")
    (box :class "tiles" :orientation "h" :space-evenly true
      (button :class "tile" :onclick "curl -sX POST ${api}/apps/wikipedia/open"
        (image :path "/opt/ujima/desktop/icons/wikipedia.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "curl -sX POST ${api}/apps/books/open"
        (image :path "/opt/ujima/desktop/icons/books.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "curl -sX POST ${api}/apps/write/open"
        (image :path "/opt/ujima/desktop/icons/write.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "curl -sX POST ${api}/apps/draw/open"
        (image :path "/opt/ujima/desktop/icons/draw.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "curl -sX POST ${api}/apps/files/open"
        (image :path "/opt/ujima/desktop/icons/files.svg" :image-width 76 :image-height 76)))))

;; --- bottom: launcher + open windows + clock -----------------------------
(defwidget dock []
  (centerbox :class "dock"
    (box :halign "start" :space-evenly false
      (for w in {desktop.windows}
        (button :class {w.id == desktop.current ? "win active" : "win"}
                :onclick "curl -sX POST ${api}/windows/${w.id}/focus"
          (image :path "/opt/ujima/desktop/icons/${w.icon}.svg" :image-width 28 :image-height 28))))
    (box)
    (box :class "tray" :halign "end" :space-evenly false :spacing 8
      (label :class "clock" :text {clock})
      (button :class "sound" :onclick "${ewwcmd} open volbackdrop; ${ewwcmd} open volume"
        (image :path {muted ? "/opt/ujima/desktop/icons/speaker-muted.svg" : "/opt/ujima/desktop/icons/speaker.svg"} :image-width 22 :image-height 22)))))


;; --- volume overlay (mock): the dock speaker toggles this popover ---------
(defwidget volpanel []
  (box :class "volpanel" :orientation "v" :space-evenly false :spacing 8 :hexpand true :vexpand true
    (label :class "volnum" :text {vol})
    (scale :class "volscale" :orientation "v" :flipped true :vexpand true :min 0 :max 100
           :value {vol} :onchange "${ewwcmd} update vol={}")
    (button :class "volmute" :onclick "${ewwcmd} update muted=${muted ? false : true}"
      (image :path {muted ? "/opt/ujima/desktop/icons/speaker-muted.svg" : "/opt/ujima/desktop/icons/speaker.svg"} :image-width 22 :image-height 22))))


;; --- surfaces ------------------------------------------------------------
(defwindow topbar
  :monitor 0 :geometry (geometry :anchor "top center" :width "100%" :height "36px")
  :wm-ignore true :stacking "fg"
  (topbar))

(defwindow launcher
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :windowtype "normal"
  (launcher))

(defwindow dock
  :monitor 0 :geometry (geometry :anchor "bottom center" :width "100%" :height "48px")
  :wm-ignore true :stacking "fg"
  (dock))

(defwindow volume
  :monitor 0 :geometry (geometry :anchor "bottom right" :width "4%" :height "210px")
  :wm-ignore true :stacking "fg"
  (volpanel))

;; invisible fullscreen click-catcher: opened with the popover (under it), any click closes both
;; so clicking outside the popover dismisses it. The popover is opened last → stacks on top.
(defwindow volbackdrop
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :wm-ignore true :stacking "fg"
  (button :hexpand true :vexpand true :onclick "${ewwcmd} close volbackdrop volume"))
