;; UjimaOS desktop shell — wired to the agent's loopback API (ujima.desktop.http,
;; 127.0.0.1:1337): widget state arrives on pushed streams (deflisten — snapshot on
;; connect, then a line per real change; settings on /ui/state, running apps on
;; /ui/apps), the launcher tiles render the app catalog (/app/catalog — immutable per
;; session, hence a poll), and clicks are plain fire-and-forget POSTs through
;; bin/ujima-api.

(defpoll clock :interval "10s" "date +%H:%M")

(defvar ewwcmd "eww --config /opt/ujima/desktop/eww")
; a launcher click steals focus from the override-redirect bars → they go dormant; only a REAL
; XTEST click on a bar re-wakes them (a click SENT via XSendEvent does not — HW-tested). Tap the
; far top-right corner: the arrow glyph draws down-right from its hotspot, so parked at 1279,0
; it clips to a ~1px sliver for the one frame it's there — effectively invisible — then hops back.
(defvar wakebars "eval $(xdotool getmouselocation --shell); xdotool mousemove 1279 0 click 1; xdotool mousemove $X $Y")

;; the authoritative UI state (JSON); the while-loop is the reconnect story — an
;; agent restart drops the connection, 1s later the snapshot line rehydrates us
(deflisten state
  :initial "{\"audio\":{\"volume\":null,\"muted\":false,\"output\":null},\"keyboard\":{\"layout\":\"--\",\"layouts\":[],\"next\":null}}"
  "while true; do curl -sN http://127.0.0.1:1337/ui/state; sleep 1; done")

;; the running apps (derived from the i3 tree) — same push contract as `state`
(deflisten apps
  :initial "{\"apps\":[],\"current\":null}"
  "while true; do curl -sN http://127.0.0.1:1337/ui/apps; sleep 1; done")

;; the launchable-app catalog: immutable per session — fetched ONCE (retry until the
;; API answers, emit, then hold the pipe open: eww drops a listener's line when the
;; script exits straight after it). If the catalog ever goes mutable it moves into
;; settings and arrives via the /ui/state converge, not a poll.
(deflisten catalog
  :initial "{\"apps\":[]}"
  "until curl -sf http://127.0.0.1:1337/app/catalog; do sleep 1; done; echo; exec sleep infinity")


;; --- top pane (v0.9 spec 33a): flat, 48px, app icon · App — Title · close (✕).
;; --- STYLE-ONLY change from the turn-14 bar — the ✕ keeps master's behaviour and
;; --- red hover; the tab underline/tint is dropped (tabs are out for v0.9). ✕ closes
;; --- the FOCUSED WINDOW. On the launcher (nothing focused) it blanks ("bar off").
;; --- Dynamic class stays on the INNER box (eww evals a window-root :class once).
(defwidget topbar []
  (box :class "topbar"
    (box :class {(apps.current?.id ?: "") == "" ? "bar off" : "bar"} :space-evenly false
      (box :class "idcell" :valign "center"
        (image :path "/opt/ujima/desktop/icons/${apps.current?.id ?: "launcher"}.svg"
               :image-width 20 :image-height 20
               :visible {(apps.current?.id ?: "") != ""}))
      (label :class "title" :halign "start" :hexpand true :text {apps.current?.title ?: ""})
      (button :class "close" :valign "center" :timeout "2s"
        :visible {(apps.current?.id ?: "") != ""}
        :onclick "/opt/ujima/desktop/bin/ujima-api POST /app/close >/dev/null"
        "✕"))))

;; --- launcher (v0.9, design 25c): apps grouped into category TRAYS — a soft
;; --- category-tinted box with a coloured label. Tiles are neutral; an OPEN app
;; --- gets a category ring + corner dot. Names hidden (hover-reveal is deferred).
;; --- Each tray renders every catalog app but shows only its own category's (GTK
;; --- collapses the hidden ones, so no gaps); jq drives the open indicator.
(defwidget traytile [entry cat]
  (button :class "tile" :timeout "2s" :visible {entry.category == cat}
    :onclick "/opt/ujima/desktop/bin/ujima-api POST /app/run '{\"appId\": \"${entry.id}\"}' >/dev/null; ${wakebars}"
    (overlay
      (box :class {"chip" + (jq(apps.apps, "any(.[]; .id == \"" + entry.id + "\")") ? " on cat-" + cat : "")} :halign "center" :valign "center"
        (image :path "/opt/ujima/desktop/icons/${entry.icon}.svg" :image-width 46 :image-height 46))
      (box :class "opendot cat-${cat}" :halign "end" :valign "start"
        :visible {jq(apps.apps, "any(.[]; .id == \"" + entry.id + "\")")}))))

(defwidget tray [cat name]
  (box :class "tray cat-${cat}" :orientation "v" :space-evenly false :valign "start"
    (box :class "trayhd" :space-evenly false :valign "center"
      (box :class "traydot")
      (label :class "traylabel" :halign "start" :xalign 0 :text name))
    (box :class "traytiles" :orientation "h" :halign "center" :space-evenly false :spacing 14
      (for entry in {catalog.apps}
        (traytile :entry entry :cat cat)))))

;; nested centerboxes reliably centre the block in BOTH axes (a lone child in a
;; plain box parks at the start); the trays block sits in the middle-of-middle.
(defwidget launcher []
  (centerbox :class "launcher" :orientation "v"
    (box)
    (centerbox :orientation "h"
      (box)
      (box :class "trays" :orientation "v" :space-evenly false :spacing 20
        (box :orientation "h" :halign "center" :space-evenly false :spacing 20 :valign "start"
          (tray :cat "learn" :name "LEARN")
          (tray :cat "office" :name "OFFICE"))
        (box :orientation "h" :halign "center" :space-evenly false :spacing 20 :valign "start"
          (tray :cat "create" :name "CREATE")
          (tray :cat "web-files" :name "WEB & FILES")))
      (box))
    (box)))

;; --- bottom: launcher tile left (lit when home), running apps centered (the
;; --- /ui/apps stream), tray right. A dock click is the same verb as a launcher
;; --- tile: run = ensure-open = focus
(defwidget dock []
  (centerbox :class "dock"
    ;; launcher / home — its dock tile is "selected" (Sand) only when the launcher IS
    ;; the active view (nothing focused); neutral once an app takes over. Same rule as
    ;; the app tiles: exactly one thing selected at a time (home, or the active app).
    (box :halign "start" :space-evenly false :spacing 6
      (button :class {(apps.current?.id ?: "") == "" ? "home active" : "home"} :timeout "2s"
        :onclick "/opt/ujima/desktop/bin/ujima-api POST /app/home >/dev/null"
        (image :path "/opt/ujima/desktop/icons/launcher.svg" :image-width 25 :image-height 25))
      ;; files: hidden from the launcher (its 'system' category) — pinned next to home. It's an
      ;; ACTION like the launcher (not an app), so it shares .home: bare at rest, frost when focused.
      (button :class {(apps.current?.id ?: "") == "files" ? "home active" : "home"} :timeout "2s"
        :onclick "/opt/ujima/desktop/bin/ujima-api POST /app/run '{\"appId\": \"files\"}' >/dev/null"
        (image :path "/opt/ujima/desktop/icons/files.svg" :image-width 26 :image-height 26)))
    ;; running apps: every open app carries a very subtle hint of its category; the ACTIVE one
    ;; blooms to the full category fill + ring
    (box :halign "center" :space-evenly false :spacing 6
      (for a in {apps.apps}
        (button :class {"win cat-" + (a.category ?: "none") + (a.id == (apps.current?.id ?: "") ? " active" : "")} :timeout "2s"
          :visible {a.category != "system"}   ; system apps (files) are pinned on the left, not shown here
          :onclick "/opt/ujima/desktop/bin/ujima-api POST /app/run '{\"appId\": \"${a.id}\"}' >/dev/null"
          (image :path "/opt/ujima/desktop/icons/${a.icon}.svg" :image-width 32 :image-height 32))))
    (box :class "tray" :halign "end" :space-evenly false :spacing 4
      ; posts back the :next the server showed us — idempotent, a double-click can't double-advance;
      ; the label flips when the push lands
      (button :class "kbd" :timeout "2s"
        :onclick "/opt/ujima/desktop/bin/ujima-api POST /api/input/keyboard/layout '{\"layout\": \"${state.keyboard.next}\"}' >/dev/null"
        (label :text {state.keyboard.layout}))
      (button :class "sound" :onclick "${ewwcmd} open volbackdrop; ${ewwcmd} open volume"
        (image :path {state.audio.muted ? "/opt/ujima/desktop/icons/speaker-muted.svg" : "/opt/ujima/desktop/icons/speaker.svg"} :image-width 19 :image-height 19))
      (label :class "clock" :text {clock}))))


;; --- volume overlay: slider moves are fire-and-forget (the agent throttles the
;; --- drag); mute posts the DESIRED state; everything reflects back via the
;; --- /ui/state push. Greyed when no output classifies (output null).
;; `vol` is eww-local interaction state: the number/knob track the finger
;; instantly instead of waiting for the push round-trip; -1 = untouched, follow
;; the agent. Once touched it pins to the last local value — fine while the
;; widget is the only volume writer.
(defvar vol -1)

(defwidget volpanel []
  (box :class "volpanel" :orientation "v" :space-evenly false :spacing 8 :hexpand true :vexpand true
    (label :class "volnum" :text {vol < 0 ? (state.audio.volume ?: "--") : vol})
    (scale :class {(state.audio.volume ?: -1) == -1 ? "volscale off" : "volscale"}
           :orientation "v" :flipped true :vexpand true :min 0 :max 101 :timeout "1s"
           :value {vol < 0 ? (state.audio.volume ?: 0) : vol}
           :onchange "${ewwcmd} update vol={} ; /opt/ujima/desktop/bin/ujima-api POST /ui/volume/move '{\"value\": {}}' >/dev/null")
    (button :class "volmute" :timeout "2s"
      :onclick "/opt/ujima/desktop/bin/ujima-api POST /api/audio/mute '{\"muted\": ${!state.audio.muted}}' >/dev/null"
      (image :path {state.audio.muted ? "/opt/ujima/desktop/icons/speaker-muted.svg" : "/opt/ujima/desktop/icons/speaker.svg"} :image-width 22 :image-height 22))))


;; --- surfaces ------------------------------------------------------------
(defwindow topbar
  :monitor 0 :geometry (geometry :anchor "top center" :width "100%" :height "48px")
  :wm-ignore true :stacking "fg"
  (topbar))

(defwindow launcher
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :windowtype "normal"
  (launcher))

(defwindow dock
  :monitor 0 :geometry (geometry :anchor "bottom center" :width "100%" :height "68px")
  :wm-ignore true :stacking "fg"
  (dock))

;; the window is larger than the card: the transparent wrapper's padding floats the
;; card above the dock and off the screen edge (margins on the ROOT widget won't do —
;; eww promotes the root's background to the whole window)
(defwindow volume
  :monitor 0 :geometry (geometry :anchor "bottom right" :width "76px" :height "330px")
  :wm-ignore true :stacking "fg"
  (box :class "volwrap" (volpanel)))

;; invisible fullscreen click-catcher: opened with the popover (under it), any click closes both
;; so clicking outside the popover dismisses it. The popover is opened last → stacks on top.
(defwindow volbackdrop
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :wm-ignore true :stacking "fg"
  (button :hexpand true :vexpand true :onclick "${ewwcmd} close volbackdrop volume"))
