;; UjimaOS desktop shell — tray volume/mute/keyboard wired to the agent's loopback API
;; (ujima.desktop.http, 127.0.0.1:1337) through bin/ujima-api; launcher tiles + dock
;; window row are still static mocks. Commands update the state vars from their own
;; responses; the defpolls only self-heal drift, so their interval can stay lazy.

(defpoll clock :interval "10s" "date +%H:%M")

(defvar ewwcmd "eww --config /opt/ujima/desktop/eww")
; a launcher click steals focus from the override-redirect bars → they go dormant; tap one to re-wake (pointer restored)
(defvar wakebars "eval $(xdotool getmouselocation --shell); xdotool mousemove 640 18 click 1; xdotool mousemove $X $Y")

;; agent state (JSON strings; safe initial so field access never sees garbage)
(defpoll audio :interval "10s"
  :initial "{\"volume\":null,\"muted\":false,\"output\":null}"
  "/opt/ujima/desktop/bin/ujima-api GET /api/audio || echo '{\"volume\":null,\"muted\":false,\"output\":null}'")

(defpoll kb :interval "30s"
  :initial "{\"layout\":\"--\",\"layouts\":[],\"next\":null}"
  "/opt/ujima/desktop/bin/ujima-api GET /api/input/keyboard || echo '{\"layout\":\"--\",\"layouts\":[],\"next\":null}'")


;; --- top: mock current-window title + inert close --------------------------
(defwidget topbar []
  (centerbox :class "topbar"
    (label :class "title" :halign "start" :text "[activity title here]")
    (box)
    (button :class "close" :halign "end" "✕")))

;; --- mid: launcher tiles (visual only) -------------------------------------
(defwidget launcher []
  (box :class "launcher" :orientation "v" :halign "center" :valign "center" :space-evenly false
    (label :class "brand" :text "Ujima")
    (box :class "tiles" :orientation "h" :space-evenly true
      (button :class "tile" :onclick "${wakebars}"
        (image :path "/opt/ujima/desktop/icons/wikipedia.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "${wakebars}"
        (image :path "/opt/ujima/desktop/icons/books.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "${wakebars}"
        (image :path "/opt/ujima/desktop/icons/write.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "${wakebars}"
        (image :path "/opt/ujima/desktop/icons/draw.svg" :image-width 76 :image-height 76))
      (button :class "tile" :onclick "${wakebars}"
        (image :path "/opt/ujima/desktop/icons/files.svg" :image-width 76 :image-height 76)))))

;; --- bottom: mock open-window row + live tray + clock -----------------------
(defwidget dock []
  (centerbox :class "dock"
    (box :halign "start" :space-evenly false
      (button :class "win"
        (image :path "/opt/ujima/desktop/icons/launcher.svg" :image-width 28 :image-height 28))
      (button :class "win active"
        (image :path "/opt/ujima/desktop/icons/wikipedia.svg" :image-width 28 :image-height 28))
      (button :class "win"
        (image :path "/opt/ujima/desktop/icons/books.svg" :image-width 28 :image-height 28))
      (button :class "win"
        (image :path "/opt/ujima/desktop/icons/write.svg" :image-width 28 :image-height 28))
      (button :class "win"
        (image :path "/opt/ujima/desktop/icons/draw.svg" :image-width 28 :image-height 28))
      (button :class "win"
        (image :path "/opt/ujima/desktop/icons/files.svg" :image-width 28 :image-height 28)))
    (box)
    (box :class "tray" :halign "end" :space-evenly false :spacing 8
      ; posts back the :next the server showed us — idempotent, a double-click can't double-advance
      (button :class "kbd" :timeout "2s"
        :onclick "/opt/ujima/desktop/bin/ujima-api POST /api/input/keyboard/layout '{\"layout\": \"${kb.next}\"}' kb"
        (label :text {kb.layout}))
      (label :class "clock" :text {clock})
      (button :class "sound" :onclick "${ewwcmd} open volbackdrop; ${ewwcmd} open volume"
        (image :path {audio.muted ? "/opt/ujima/desktop/icons/speaker-muted.svg" : "/opt/ujima/desktop/icons/speaker.svg"} :image-width 22 :image-height 22)))))


;; --- volume overlay: slider moves are fire-and-forget (the agent debounces the
;; --- drag into one settings write); mute posts the DESIRED state and refreshes
;; --- `audio` from the response. Greyed when no output classifies (output null).
;; `vol` mirrors the interaction so the number/knob react instantly instead of
;; waiting out the poll; -1 = untouched, follow the agent. Once touched it pins
;; to the last local value — fine while the widget is the only volume writer;
;; the push layer replaces this.
(defvar vol -1)

(defwidget volpanel []
  (box :class "volpanel" :orientation "v" :space-evenly false :spacing 8 :hexpand true :vexpand true
    (label :class "volnum" :text {vol < 0 ? (audio.volume ?: "--") : vol})
    (scale :class {(audio.volume ?: -1) == -1 ? "volscale off" : "volscale"}
           :orientation "v" :flipped true :vexpand true :min 0 :max 101 :timeout "1s"
           :value {vol < 0 ? (audio.volume ?: 0) : vol}
           :onchange "${ewwcmd} update vol={} ; /opt/ujima/desktop/bin/ujima-api POST /shell/volume/move '{\"value\": {}}' >/dev/null")
    (button :class "volmute" :timeout "2s"
      :onclick "/opt/ujima/desktop/bin/ujima-api POST /api/audio/mute '{\"muted\": ${!audio.muted}}' audio"
      (image :path {audio.muted ? "/opt/ujima/desktop/icons/speaker-muted.svg" : "/opt/ujima/desktop/icons/speaker.svg"} :image-width 22 :image-height 22))))


;; --- surfaces ------------------------------------------------------------
(defwindow topbar
  :monitor 0 :geometry (geometry :anchor "top center" :width "100%" :height "36px")
  :wm-ignore true :stacking "fg"
  (topbar))

(defwindow launcher
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :windowtype "normal"
  (launcher))

(defwindow dock
  :monitor 0 :geometry (geometry :anchor "bottom center" :width "100%" :height "48px")
  :wm-ignore true :stacking "fg"
  (dock))

(defwindow volume
  :monitor 0 :geometry (geometry :anchor "bottom right" :width "4%" :height "210px")
  :wm-ignore true :stacking "fg"
  (volpanel))

;; invisible fullscreen click-catcher: opened with the popover (under it), any click closes both
;; so clicking outside the popover dismisses it. The popover is opened last → stacks on top.
(defwindow volbackdrop
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :wm-ignore true :stacking "fg"
  (button :hexpand true :vexpand true :onclick "${ewwcmd} close volbackdrop volume"))
