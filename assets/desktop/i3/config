# UjimaOS — minimal i3 config. No i3bar; eww is the top bar + dock, the launcher is a webview,
# the agent owns app/window lifecycle.
# new windows stack as tabs (cover the previous), never tile-split; font 1 + a
# topbar-matched palette shrink the only surviving decoration — the tab bar — to
# an invisible ~2px sliver that blends into the topbar above it
font pango:Inter 1
default_border none
default_floating_border none
hide_edge_borders both
workspace_layout tabbed
client.focused          #1b2027 #1b2027 #1b2027 #1b2027 #1b2027
client.focused_inactive #1b2027 #1b2027 #1b2027 #1b2027 #1b2027
client.unfocused        #1b2027 #1b2027 #1b2027 #1b2027 #1b2027
client.urgent           #1b2027 #1b2027 #1b2027 #1b2027 #1b2027

# real dialogs float; deliberately NO fullscreen keybind — the eww bars must stay visible.
# chromium --app windows auto-float (fixed size hints) but set class/role only AFTER mapping, so
# for_window can't catch them here — the agent un-floats app windows instead (settle-floaters!).
for_window [window_type="dialog"]  floating enable
for_window [window_type="utility"] floating enable
# open/save file choosers overflow the bars when floated (buttons hide behind the dock) — TILE them
# instead: a tiled window fills exactly the band between the top bar and dock at any resolution
# (i3's gaps handle the fixed 48/68px), so no hardcoded size. Targets the GTK chooser role so small
# confirm dialogs still float.
for_window [window_role="GtkFileChooserDialog"] floating disable

# eww topbar/dock are :wm-ignore (override-redirect) in eww.yuck, so i3 doesn't manage them; the
# launcher (a webview, WM_CLASS ujima-launcher) is a normal window the agent tracks + places on
# HOME like any app.

# the bars reserve no strut, so reserve their space here — keep in sync with eww.yuck heights
# (topbar :height 48px, dock :height 68px) so the launcher + apps sit in the mid-section.
gaps top 48
gaps bottom 68

# super+space cycles the keyboard layout — through the agent (concrete-state POST),
# NEVER an XKB group toggle: X-side switching would drift from the control plane
# and the next converge would snap it back.
bindsym Mod4+space exec --no-startup-id /opt/ujima/desktop/bin/ujima-kbd-next

# desktop background: the launcher's gradient (assets/desktop/wall.svg, rasterized to wall.png by
# tools.scripts.desktop) set on the X root. i3 draws over it, so empty workspaces show the gradient
# instead of the black root — and the transparent launcher + top bar show it through, one continuous
# background under everything.
exec_always --no-startup-id feh --bg-fill /opt/ujima/desktop/wall.png

# the agent owns the shell now: it reconciles settings, then brings up eww (top bar + dock) and
# the webview launcher itself once ready — so i3 only launches the agent + the compositor below.
exec --no-startup-id ujima-agent

# compositor: picom (xrender — no GL on the Pi) gives real transparency, so floating eww overlays
# (the volume popover) show the dock/content through them instead of painting a black block.
exec_always --no-startup-id picom --backend xrender --unredir-if-possible
