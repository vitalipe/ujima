# UjimaOS — minimal i3 config. No i3bar; eww is the shell, the agent owns app/window lifecycle.
font pango:Inter 10
default_border none
default_floating_border none
hide_edge_borders both

# dialogs/popups float; deliberately NO fullscreen keybind — the eww bars must stay visible
for_window [window_type="dialog"]  floating enable
for_window [window_type="utility"] floating enable
for_window [window_role="pop-up"]  floating enable

# eww topbar/dock are :wm-ignore (override-redirect) in eww.yuck, so i3 doesn't manage them;
# the launcher is a normal window the agent tracks + places on its own workspace like any app.

# the bars reserve no strut, so reserve their space here — keep in sync with eww.yuck heights
# (topbar :height 36px, dock :height 48px) so apps tile into the mid-section, not under the bars.
gaps top 36
gaps bottom 48

# super+space cycles the keyboard layout — through the agent (concrete-state POST),
# NEVER an XKB group toggle: X-side switching would drift from the control plane
# and the next converge would snap it back.
bindsym Mod4+space exec --no-startup-id /opt/ujima/desktop/bin/ujima-kbd-next

# the agent owns the shell now: it reconciles settings, then brings up eww (daemon + surfaces)
# itself once ready — so i3 only launches the agent + the compositor below.
exec --no-startup-id ujima-agent

# compositor: picom (xrender — no GL on the Pi) gives real transparency, so floating eww overlays
# (the volume popover) show the dock/content through them instead of painting a black block.
exec_always --no-startup-id picom --backend xrender
