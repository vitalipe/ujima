{:paths ["runtime/src" "tools/src" "os" "desktop/console/src"]

 :deps {http-kit/http-kit {:mvn/version "2.8.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.babashka/http-client {:mvn/version "0.4.23"}
        com.taoensso/timbre {:mvn/version "6.6.1"}
        ujima/deps {:local/root "."}}

 :tasks
 {build
  {:doc "Whole pipeline: vendor(cached) → os image → pack → A/B disk"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "build" *command-line-args*)}

  stage
  {:doc "Stage an image from the pinned base (vendor-cached)"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "stage" *command-line-args*)}

  os
  {:doc "An OS image: apply | script | chroot"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "os" *command-line-args*)}

  pack
  {:doc "The .pack artifact: <src> <out> | validate | meta"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "pack" *command-line-args*)}

  disk
  {:doc "The A/B disk: ab create | slot A|B from-pack/from-image/activate | info"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "disk" *command-line-args*)}

  dev
  {:doc "A running device over ssh: push | script | view | screenshot | click | type | key"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "dev" *command-line-args*)}

  loopback
  {:doc "Loop-device utility: attach | detach | list"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main "loopback" *command-line-args*)}

  console
  {:doc "Console dev (Circle + Setup panels): mock (server, :1338) | world (mock-world TUI)"
   :task (case (first *command-line-args*)
           "mock"  ((requiring-resolve 'console.main/-main))
           "world" ((requiring-resolve 'console.world/-main))
           (do (println "usage: bb console <mode>")
               (println "  mock   console server on the mock fleet (http://localhost:1338)")
               (println "  world  TUI driving tmp/console/world.edn (add/drop, set counts)")
               (println "  real   (later) console server against live ujima peers")))}

  repl
  {:doc "Start Ujima dev REPL"
   :override-builtin true
   :task (shell "bb" "--config" "bb.repl.edn" "-e" "(require 'tools.repl) (tools.repl/start!)")}

  pin
  {:doc "Pin world-truth into the repo: bb pin <schema|deps|initramfs> …"
   :requires ([tools.cmd.pin :as pin])
   :task (apply pin/dispatch! *command-line-args*)}

  test:unit
  {:doc "Run unit tests"
   :task (shell "bb" "--config" "bb.test.edn" "-m" "runner")}

  test:integration
  {:doc "Run an integration test from runtime/test/integration/tests"
   :task (apply shell "bb" "--config" "bb.integration.edn" "-m" "integration.runner" (seq *command-line-args*))}}}

