{:paths ["src" "tools/src"]

 :deps {http-kit/http-kit {:mvn/version "2.8.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.babashka/http-client {:mvn/version "0.4.23"}
        com.taoensso/timbre {:mvn/version "6.6.1"}}

 :tasks
 {e2e
  {:doc "Run an e2e test from e2e/tests"
   :task (apply shell "bb" "-cp" "src:test" "-m" "e2e.runner" (seq *command-line-args*))}

  tools
  {:doc "Tools CLI"
   :requires ([tools.cli :as cli])
   :task (apply cli/-main *command-line-args*)}

  dev
  {:doc "Start Ujima dev REPL"
   :task (shell "bb" "-cp" "src:tools/src:test" "-e" "(require 'tools.repl) (tools.repl/start!)")}

  test:unit
  {:doc "Run unit tests"
   :task (shell "bb" "-cp" "src:test/unit" "-m" "runner")}

  app-catalog
  {:doc "Regenerate the dev app catalog (assets/desktop/apps.edn) from tools.scripts.appcatalog"
   :requires ([tools.scripts.appcatalog :as appcatalog])
   :task (appcatalog/write-catalog! {:dest "assets/desktop/apps.edn"})}}}

