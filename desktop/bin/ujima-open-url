#!/bin/sh
# The URL handler: hand every link to ujimad, which opens it in the Web app.
url="$1"
case "$url" in
  http://*|https://*) ;;
  *) exit 0 ;;
esac
esc=$(printf '%s' "$url" | sed 's/\\/\\\\/g; s/"/\\"/g')
exec curl -fsS -m 2 -X POST -H 'content-type: application/json' \
  -d "{\"url\":\"$esc\"}" http://127.0.0.1:1337/api/commands/app/open-url >/dev/null 2>&1
