#!/bin/sh
# eww / i3 -> ujimad's desktop tier (127.0.0.1:1336). Keeps curl/quoting out of yuck.
# The signed /api tier on :1337 is for OTHER machines — the desktop never speaks it.
#   ujima-ui POST /ui/app/home                                    # writes are 202, no body
#   ujima-ui POST /ui/app/open '{"app": "files"}'
#   ujima-ui GET  /ui/keyboard/layout/next                        # prints the response
set -eu
method=$1
path=$2
body=${3:-}
curl -sf --max-time 3 -X "$method" ${body:+-d "$body"} "http://127.0.0.1:1336$path"
