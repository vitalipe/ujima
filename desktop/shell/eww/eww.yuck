;; UjimaOS desktop shell — wired to ujimad's desktop tier, mounted at ujima-desktop
;; on 127.0.0.1:1336 (the signed /api tier on :1337 is for other machines; the
;; desktop never speaks it): widget state arrives on pushed streams (deflisten —
;; snapshot on connect, then a line per real change; settings on stream/state,
;; running apps on stream/apps), the launcher tiles render the app catalog
;; (app/catalog — immutable per session, hence a poll), and clicks are plain
;; fire-and-forget POSTs through bin/ujima-desktop, which owns the mount.

(defpoll clock :interval "10s" "date +%H:%M")
(defpoll lockdate :interval "1h" "date +'%A, %B %-d'")

; a launcher click steals focus from the override-redirect bars → they go dormant; only a REAL
; XTEST click on a bar re-wakes them (a click SENT via XSendEvent does not — HW-tested). Tap the
; far top-right corner: the arrow glyph draws down-right from its hotspot, so parked at 1279,0
; it clips to a ~1px sliver for the one frame it's there — effectively invisible — then hops back.
(defvar wakebars "eval $(xdotool getmouselocation --shell); xdotool mousemove 1279 0 click 1; xdotool mousemove $X $Y")

;; the authoritative UI state (JSON); the while-loop is the reconnect story — an
;; ujimad restart drops the connection, 1s later the snapshot line rehydrates us
(deflisten state
  :initial "{\"audio\":{\"volume\":null,\"muted\":false,\"output\":null},\"keyboard\":{\"layout\":\"--\",\"layouts\":[],\"next\":null}}"
  "while true; do curl -sN http://127.0.0.1:1336/ujima-desktop/stream/state; sleep 1; done")

;; the running apps (derived from the i3 tree) — same push contract as `state`
(deflisten apps
  :initial "{\"running\":[],\"pinned\":[],\"current\":null}"
  "while true; do curl -sN http://127.0.0.1:1336/ujima-desktop/stream/apps; sleep 1; done")

;; launcher tiles: fetched ONCE (the sleep holds the pipe open — eww drops a listener's
;; line if the script exits). Runtime :hidden changes reach the dock, not this. Dynamic soon.
(deflisten catalog
  :initial "{\"apps\":[]}"
  "until curl -sf http://127.0.0.1:1336/ujima-desktop/app/catalog; do sleep 1; done; echo; exec sleep infinity")


;; --- top pane (v0.9 spec 33a): flat, 48px, app icon · App — Title · close (✕).
;; --- STYLE-ONLY change from the turn-14 bar — the ✕ keeps master's behaviour and
;; --- red hover; the tab underline/tint is dropped (tabs are out for v0.9). ✕ closes
;; --- the FOCUSED WINDOW. On the launcher (nothing focused) it blanks ("bar off").
;; --- Dynamic class stays on the INNER box (eww evals a window-root :class once).
(defwidget topbar []
  (box :class "topbar"
    (box :class {(apps.current?.id ?: "") == "" ? "bar off" : "bar"} :space-evenly false
      (box :class "idcell" :valign "center"
        (image :path "${apps.current?.icon ?: "/ujima/desktop/shell/icons/launcher.svg"}"
               :image-width 20 :image-height 20
               :visible {(apps.current?.id ?: "") != ""}))
      (label :class "title" :halign "start" :hexpand true :text {apps.current?.title ?: ""})
      ;; close. The old ✕ was a bare U+2715 text glyph in $dim with no chip: against 48px of
      ;; empty strip it rendered as a thin hairline and read as decoration, not a button. This is
      ;; a lucide SVG, still chipless — the fix was never a box, it was weight and colour. The
      ;; stroke is baked into the SVG and GTK will not recolour it, so the red that makes a
      ;; chipless glyph visible lives in the file; only the hover fill lives in CSS.
      (button :class "wbtn close" :valign "center" :timeout "2s"
        :visible {(apps.current?.id ?: "") != ""}
        :tooltip "Close ${apps.current?.label ?: ""}"
        :onclick "ujima-desktop POST commands/app/close >/dev/null"
        (image :path "/ujima/desktop/shell/icons/close.svg" :image-width 17 :image-height 17)))))

;; --- launcher (v0.9, design 25c): apps grouped into category TRAYS — a soft
;; --- category-tinted box with a coloured label. Tiles are neutral; an OPEN app
;; --- gets a category ring + corner dot. Names hidden (hover-reveal is deferred).
;; --- Each tray renders every catalog app but shows only its own category's (GTK
;; --- collapses the hidden ones, so no gaps); jq drives the open indicator.
(defwidget traytile [entry cat]
  (button :class "tile" :timeout "2s" :visible {entry.category == cat}
    :onclick "ujima-desktop POST commands/app/open '{\"app\": \"${entry.id}\"}' >/dev/null; ${wakebars}"
    (overlay
      (box :class {"chip" + (jq(apps.running, "any(.[]; .id == \"" + entry.id + "\")") ? " on cat-" + cat : "")} :halign "center" :valign "center"
        (image :path "${entry.icon}" :image-width 46 :image-height 46))
      (box :class "opendot cat-${cat}" :halign "end" :valign "start"
        :visible {jq(apps.running, "any(.[]; .id == \"" + entry.id + "\")")}))))

(defwidget tray [cat name]
  (box :class "tray cat-${cat}" :orientation "v" :space-evenly false :valign "start"
    (box :class "trayhd" :space-evenly false :valign "center"
      (box :class "traydot")
      (label :class "traylabel" :halign "start" :xalign 0 :text name))
    (box :class "traytiles" :orientation "h" :halign "center" :space-evenly false :spacing 14
      (for entry in {catalog.apps}
        (traytile :entry entry :cat cat)))))

;; nested centerboxes reliably centre the block in BOTH axes (a lone child in a
;; plain box parks at the start); the trays block sits in the middle-of-middle.
(defwidget launcher []
  (centerbox :class "launcher" :orientation "v"
    (box)
    (centerbox :orientation "h"
      (box)
      (box :class "trays" :orientation "v" :space-evenly false :spacing 20
        (box :orientation "h" :halign "center" :space-evenly false :spacing 20 :valign "start"
          (tray :cat "learn" :name "LEARN")
          (tray :cat "office" :name "OFFICE"))
        (box :orientation "h" :halign "center" :space-evenly false :spacing 20 :valign "start"
          (tray :cat "create" :name "CREATE")
          (tray :cat "web-files" :name "WEB & FILES")))
      (box))
    (box)))

;; both the speaker and the number toggle mute, so the verb, its tooltip and its disabled case
;; live in ONE place — two copies of a ternary this shape would drift the first time either moved.
(defwidget mutebtn [cls]
  (button :class cls :timeout "2s"
    :tooltip "${(state.audio.volume ?: -1) == -1 ? "No audio output" : (state.audio.muted ? "Unmute" : "Mute")}"
    :onclick "ujima-desktop POST commands/audio/muted '{\"value\": ${!state.audio.muted}}' >/dev/null"
    (children)))

;; --- volume, INLINE in the dock (replaces the popover + backdrop pair): hovering the
;; --- speaker slides a slider out to its LEFT. Left, not right, is load-bearing — the tray
;; --- is right-anchored, so growing leftwards leaves the speaker under the pointer exactly
;; --- where it was; a reveal that moved its own trigger would chase the cursor out of the
;; --- eventbox and flap. Click on the speaker mutes.
;; `vol` is eww-local interaction state: the number/knob track the finger instantly instead of
;; waiting for the push round-trip; -1 = untouched, follow ujimad. Hover-lost clears it, so the
;; next reveal starts from ujimad's truth rather than a stale local number.
(defvar vol -1)
(defvar volopen false)

(defwidget volinline []
  (eventbox :class {volopen ? "volbox open" : "volbox"} :valign "center"
    :onhover "${EWW_CMD} --no-daemonize update volopen=true"
    :onhoverlost "${EWW_CMD} --no-daemonize update volopen=false vol=-1"
    (box :space-evenly false :spacing 4
      (revealer :transition "slideleft" :duration "180ms" :reveal volopen
        (box :space-evenly false :spacing 8
          (scale :class {"volscale" + ((state.audio.volume ?: -1) == -1 ? " off" : "") + (state.audio.muted ? " muted" : "")}
                 :valign "center" :orientation "h" :min 0 :max 101 :timeout "1s"
                 :value {vol < 0 ? (state.audio.volume ?: 0) : vol}
                 :onchange "${EWW_CMD} --no-daemonize update vol={} ; ujima-desktop POST ui/volume/move '{\"value\": {}}' >/dev/null")
          (mutebtn :cls "volnumbtn"
            (label :class "volnum" :xalign 1
                   :text {(state.audio.volume ?: -1) == -1 ? "--" : (vol < 0 ? state.audio.volume : vol)}))))
      (mutebtn :cls "sound"
        ;; the glyph carries the level, not just mute: cone / one arc / two arcs, so a glance
        ;; at the closed tray already says roughly how loud the machine is
        (image :image-width 20 :image-height 20
               :path {state.audio.muted                    ? "/ujima/desktop/shell/icons/speaker-muted.svg"
                      : (state.audio.volume ?: 0) == 0     ? "/ujima/desktop/shell/icons/speaker-off.svg"
                      : (state.audio.volume ?: 0) <= 50    ? "/ujima/desktop/shell/icons/speaker-low.svg"
                      :                                      "/ujima/desktop/shell/icons/speaker.svg"})))))

;; --- keyboard layout: the volume's shape reused. Hovering slides the OTHER installed layouts
;; --- out to the LEFT of the current one, each a direct pick — leftward because the tray is
;; --- right-anchored, so the chip under the pointer stays put. With a single layout there is
;; --- nothing to choose and only the hover well appears; the reveal is gated on the count, not
;; --- hidden by CSS, so one layout costs no widgets. Clicking the current chip still cycles,
;; --- which is what Super+Space does and the only thing a one-layout machine could do anyway.
(defvar kbdopen false)

(defwidget kbdinline []
  (eventbox :class {kbdopen ? "kbdbox open" : "kbdbox"} :valign "center"
    :onhover "${EWW_CMD} --no-daemonize update kbdopen=true"
    :onhoverlost "${EWW_CMD} --no-daemonize update kbdopen=false"
    (box :space-evenly false :spacing 2
      (revealer :transition "slideleft" :duration "180ms"
                :reveal {kbdopen && arraylength(state.keyboard.layouts) > 1}
        (box :class "kbdalts" :space-evenly false :spacing 2
          ;; every layout is rendered and the CURRENT one hidden — GTK collapses a hidden child,
          ;; so the row closes up with no gap (same trick the launcher trays use)
          (for l in {state.keyboard.layouts}
            (button :class "kbdalt" :timeout "2s" :visible {l != state.keyboard.layout}
              :tooltip "Switch to ${l}"
              :onclick "ujima-desktop POST commands/keyboard/layout '{\"layout\": \"${l}\"}' >/dev/null"
              (label :text l)))))
      ;; :valign centre, like the volume box — without it the tray stretches the button to the
      ;; dock's full inner height and no amount of padding tuning can make its hover pill match
      (button :class "kbd" :valign "center" :timeout "2s"
        :tooltip "Keyboard layout"
        :onclick "ujima-desktop POST commands/keyboard/layout '{\"layout\": \"${state.keyboard.next}\"}' >/dev/null"
        ;; code THEN icon: the icon becomes the control's fixed right anchor, exactly like the
        ;; speaker's, so both tray controls are the same shape — anchor on the right, everything
        ;; that opens growing leftwards away from the pointer.
        (box :space-evenly false :spacing 7 :valign "center"
          (label :text {state.keyboard.layout})
          (image :path "/ujima/desktop/shell/icons/keyboard.svg" :image-width 20 :image-height 20))))))

;; --- bottom: launcher tile left (lit when home), running apps centered (the
;; --- stream/apps), tray right. A dock click is the same verb as a launcher
;; --- tile: run = ensure-open = focus
(defwidget dock []
  (centerbox :class "dock"
    ;; launcher / home — its dock tile is "selected" (Sand) only when the launcher IS
    ;; the active view (nothing focused); neutral once an app takes over. Same rule as
    ;; the app tiles: exactly one thing selected at a time (home, or the active app).
    (box :halign "start" :space-evenly false :spacing 6
      (button :class {(apps.current?.id ?: "") == "" ? "home active" : "home"} :timeout "2s"
        :tooltip "Apps"
        :onclick "ujima-desktop POST commands/app/home >/dev/null"
        (image :path "/ujima/desktop/shell/icons/launcher.svg" :image-width 25 :image-height 25))
      ;; pinned: ujimad decides the list (files always, console once a token unhides it); this
      ;; only renders it. ACTIONS like the launcher, not apps, so they share .home.
      (for p in {apps.pinned}
        (button :class {p.id == (apps.current?.id ?: "") ? "home active" : "home"} :timeout "2s"
          :tooltip "${p.label}"
          :onclick "ujima-desktop POST commands/app/open '{\"app\": \"${p.id}\"}' >/dev/null"
          (image :path "${p.icon}" :image-width 26 :image-height 26))))
    ;; running apps: every open app carries a very subtle hint of its category; the ACTIVE one
    ;; blooms to the full category fill + ring
    (box :halign "center" :space-evenly false :spacing 6
      (for a in {apps.running}
        (button :class {"win cat-" + (a.category ?: "none") + (a.id == (apps.current?.id ?: "") ? " active" : "")} :timeout "2s"
          :visible {a.category != "system"}   ; system apps (files) are pinned on the left, not shown here
          :tooltip "${a.label}"
          :onclick "ujima-desktop POST commands/app/open '{\"app\": \"${a.id}\"}' >/dev/null"
          (image :path "${a.icon}" :image-width 32 :image-height 32))))
    (box :class "tray" :halign "end" :space-evenly false :spacing 4
      ; posts back the :next the server showed us — idempotent, a double-click can't double-advance;
      ; the label flips when the push lands
      ;; the layout code alone ("tz") was the one tray item with no icon — it read as a typo
      ;; more than a control. Icon + code: the icon says what it is, the code says which.
      (kbdinline)
      (volinline)
      ;; hairline: everything left of it is a control, the clock right of it is a readout
      (box :class "traysep" :valign "center")
      (label :class "clock" :tooltip {lockdate} :text {clock}))))


;; --- surfaces ------------------------------------------------------------
(defwindow topbar
  :monitor 0 :geometry (geometry :anchor "top center" :width "100%" :height "48px")
  :wm-ignore true :stacking "fg"
  (topbar))

(defwindow launcher
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :windowtype "normal"
  (launcher))

(defwindow dock
  :monitor 0 :geometry (geometry :anchor "bottom center" :width "100%" :height "68px")
  :wm-ignore true :stacking "fg"
  (dock))

;; SPIKE — the lock screen as shell state rather than an app: a fullscreen window this
;; daemon already holds, opened on lock and closed on unlock. Opened last so it stacks
;; over the bars (opened last = stacked last among :wm-ignore "fg" windows).
(defwidget lockscreen []
  (box :class "lockscreen"
    (box :class "lockcard" :orientation "v" :halign "center" :valign "center"
         :space-evenly false :spacing 26
      (box :class "lockchip" :halign "center" :valign "center"
        (image :path "/ujima/desktop/shell/icons/lock.svg" :image-width 46 :image-height 46))
      (label :class "locktitle" :text "Locked")
      (box :orientation "v" :space-evenly false :spacing 4
        (label :class "locktime" :text {clock})
        (label :class "lockdate" :text {lockdate})))))

(defwindow lockscreen
  :monitor 0 :geometry (geometry :anchor "center" :width "100%" :height "100%")
  :windowtype "normal"
  (lockscreen))
