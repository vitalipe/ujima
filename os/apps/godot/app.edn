;; opens the editor straight into the vendored 2D platformer demo (../godot-demo — the payload
;; dir beside this one; cwd = this app dir, so the spec works from any root) — wow-on-open
;; instead of an empty Project Manager. Forced to Vulkan Mobile: the V3D does Vulkan 1.3 but
;; not the Forward+/Clustered tier (<48 textures/stage), and Mobile is the right renderer for
;; a Pi GPU.
{:kind :exec :label "Godot" :category :code
 :exec ["./godot" "--editor" "--path" "../godot-demo"
        "--rendering-driver" "vulkan" "--rendering-method" "mobile"]
 :window {:class "Godot"}}  ; res_class, xprop-verified
