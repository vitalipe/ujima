;; --full-screen no: start WINDOWED (overrides config.ini every launch). Stellarium's own
;; fullscreen has no exit UI and the Pi 500 has no F11 key, so it must never own the screen —
;; windowed, it tiles in the band with the top bar's ✕ to close it.
{:kind :exec :label "Stellarium" :category :explore
 :exec ["stellarium" "--full-screen" "no"]
 :class "stellarium"}  ; xprop-verified
