# managed by the ujima image build — source: os/desktop/links/ujima-open-url.desktop
#
# url handler: xdg-open (via mimeapps.list, staged beside this) resolves http/https to
# this .desktop -> bin/ujima-open-url -> the Web app.
[Desktop Entry]
Type=Application
Name=Ujima URL Handler
Exec=/ujima/desktop/bin/ujima-open-url %u
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
NoDisplay=true
