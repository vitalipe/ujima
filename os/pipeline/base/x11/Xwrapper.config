# managed by the ujima image build — source: os/pipeline/base/x11/Xwrapper.config
#
# X-from-systemd: let a non-console user start X via the setuid wrapper
# (xserver-xorg-legacy, the install stage). HW-verified — without it Xorg dies
# "Cannot open virtual console (Permission denied)".
allowed_users=anybody
needs_root_rights=yes
