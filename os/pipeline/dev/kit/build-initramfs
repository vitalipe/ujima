#!/bin/sh
# build-initramfs — regenerate the overlayroot initramfs natively on THIS Pi and stage it,
# version-named, for copying into the repo's os/pipeline/boot/initramfs/. Run as root.
#
# The image build can't generate this initramfs (update-initramfs segfaults under qemu), so the boot
# stage bakes a prebuilt one instead. This script produces that artifact: it
# re-enables update-initramfs (the image ships it off), regenerates for all installed kernels, and
# copies the results into /ujima/dev/initramfs-out/<kernel-version>/. Copy that <version>/ folder
# straight into the repo's os/pipeline/boot/initramfs/ — the build selects it by kernel version.
#
# Run on a dev Pi (overlayroot installed) with the overlay DISABLED: update-initramfs can't resolve
# the root device when / is the overlay, so `lock-fs disable` + reboot first, then run this.
set -eu

# bail loudly if the overlay is still on (else update-initramfs dies: "failed to determine device for /")
if [ "$(findmnt -no FSTYPE /)" = overlay ]; then
    echo "build-initramfs: / is the overlay — run 'lock-fs disable', reboot, then re-run this." >&2
    exit 1
fi

conf=/etc/initramfs-tools/update-initramfs.conf
ver=$(ls /lib/modules | grep '+rpt' | sed 's/-rpi-.*//' | sort -u | head -1)
[ -n "$ver" ] || { echo "build-initramfs: could not derive a kernel version from /lib/modules" >&2; exit 1; }
out=/ujima/dev/initramfs-out/$ver
echo "kernel: $ver"

# the image ships update_initramfs=no; turn it on just for this regen, then back off
sed -i 's/^update_initramfs=.*/update_initramfs=yes/' "$conf"
update-initramfs -u -k all
sed -i 's/^update_initramfs=.*/update_initramfs=no/' "$conf"

mkdir -p "$out"
for f in initramfs8 initramfs_2712; do
    if [ -f "/boot/firmware/$f" ]; then
        cp "/boot/firmware/$f" "$out/$f"
        echo "  staged $f ($(lsinitramfs "/boot/firmware/$f" 2>/dev/null | grep -c overlayroot) overlayroot entries)"
    else
        echo "  WARN: /boot/firmware/$f missing" >&2
    fi
done

echo
echo "staged -> $out"
echo "copy it into the repo, e.g.:  scp -r ujima@<this-pi>:$out  <repo>/os/pipeline/boot/initramfs/"
