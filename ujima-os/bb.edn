{:paths ["src"]

 :deps {http-kit/http-kit {:mvn/version "2.8.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.babashka/http-client {:mvn/version "0.4.23"}
        com.taoensso/timbre {:mvn/version "6.6.1"}}

 :tasks
 {http {:doc "Run Ujima HTTP server"
        :task (apply shell "bb" "-m" "ujima.http"
                     (or (seq *command-line-args*)
                         ["config/ujima.edn"]))}

  cli {:doc "Run Ujima CLI"
       :task (apply shell "bb" "-m" "ujima.cli"
                    (or (seq *command-line-args*)
                        ["config/ujima.edn"]))}

  test-http {:doc "Run HTTP smoke tests"
             :task (apply shell "bb" "-m" "ujima.test.http"
                          (or (seq *command-line-args*)
                              ["config/ujima.edn"]))}

  test-cli {:doc "Run CLI smoke tests"
            :task (apply shell "bb" "-m" "ujima.test.cli"
                         (or (seq *command-line-args*)
                             ["config/ujima.edn"]))}}}